# Copy this file to .env and fill in real values.
# .env is ignored by git; this example file is safe to commit.

# Gemini API key from https://aistudio.google.com (or Google Cloud)
GEMINI_API_KEY=your_key_here

# Model name: use a current "flash" model listed in AI Studio
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Frontend URL allowed to call the API (use * while developing)
FRONTEND_ORIGIN=*
